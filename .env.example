# Voice agent + booking — set these in Vercel (Production + Preview) as well.

# ── Build-time (exposed to the browser; must be prefixed VITE_) ──
VITE_VAPI_PUBLIC_KEY=            # Vapi dashboard → API Keys → PUBLIC key
VITE_VAPI_ASSISTANT_ID=          # printed by scripts/setup-vapi-assistant.mjs
# VITE_VOICE_PHONE_NUMBER=       # optional "+1 ..." — shown on site if a Vapi number is attached

# ── Server-only (used by /api/vapi-tools; never exposed to the browser) ──
CALCOM_API_KEY=                  # Cal.com > Settings > Developer > API keys
CALCOM_EVENT_TYPE_ID=            # numeric id of the "Intro Call" event type
TOOL_WEBHOOK_SECRET=             # shared secret; sent by Vapi as x-vapi-secret
# CALCOM_API_VERSION=2024-08-13  # optional override (bookings)
# CALCOM_SLOTS_VERSION=2024-09-04 # optional override (slots)

# ── Only needed locally to run scripts/setup-vapi-assistant.mjs (not stored on Vercel) ──
# VAPI_API_KEY=                  # Vapi dashboard → API Keys → PRIVATE key
# SITE_URL=https://www.corefix.app

# ── AI Ops Setup Session (/ai-ops-setup) ──
# Checked 2026-09-29 on Vercel project corefix-website: Cal.com + Vapi only.
# No Stripe keys, no Vercel Blob, no KV/Upstash. Do not invent values.

# Build-time. Defaults to the live event if unset.
VITE_CAL_AI_OPS_LINK=corefix.ai/aios-setup-session-60-min

# Stripe Checkout — $97 CAD. Required before the paid path works.
# BLOCKER: STRIPE_SECRET_KEY is not set on Vercel (production or preview).
STRIPE_SECRET_KEY=
# Optional. If set, the API refuses it unless the Price is one-time 9700 CAD.
# If empty, Checkout is created with price_data unit_amount 9700 currency cad.
STRIPE_PRICE_ID_AI_OPS=
# Optional in v1. The book page confirms payment by retrieving the Checkout Session.
STRIPE_WEBHOOK_SECRET=

# Free seats: first AI_OPS_FREE_CAP bookings (default 3). Counted claims, not a promo code.
AI_OPS_FREE_CAP=3

# Durable counter — set ONE of these. POST /api/ai-ops-slots rejects claims until one is present.
# Preferred: Vercel Blob (private store). Each seat is a create-if-absent slot file.
#   BLOB_READ_WRITE_TOKEN=   # Vercel → Storage → Blob, or connect the store to this project
#   BLOB_STORE_ID=           # with Vercel OIDC when the store is connected (no long-lived token)
# Alternate: Upstash Redis / Vercel KV REST (atomic INCR via EVAL).
#   KV_REST_API_URL=
#   KV_REST_API_TOKEN=
#   # aliases also read: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN

# Read-only snapshot used ONLY when Blob and KV are both unset.
# It changes the "X of 3 free left" badge. It does not persist new claims.
# Set to 3 after three manual comps if storage is still disconnected — everyone then goes to Stripe.
# BLOCKER: no Blob/KV on corefix-website, so free claims cannot be counted until a store above is connected.
AI_OPS_FREE_CLAIMED=0

# Private by default. Use public only if the Blob store itself is public (claims include email — avoid this).
# AI_OPS_BLOB_ACCESS=private

{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "corefix.app" }],
      "destination": "https://www.corefix.app/:path*",
      "permanent": true
    },
    {
      "source": "/spec-studio/",
      "destination": "/spec-studio",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
